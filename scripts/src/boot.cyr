# boot.cyr — AGNOS sovereign boot pipeline
#
# Assembles and boots AGNOS from sibling repo components.
# No manual includes — cyrius build auto-resolves from cyrius.toml.
#
# Usage:
#   cyrius build src/boot.cyr build/boot
#   ./build/boot                  # direct boot (fastest)
#   ./build/boot --test           # boot + validate serial output
#   ./build/boot --kernel PATH    # custom kernel path
#   ./build/boot -v               # verbose

# --- helpers ---

fn prints(s) { syscall(1, 1, s, strlen(s)); }

fn print_int(n) { print_num(n); }

# --- state ---

var kernel_path = 0;
var mode = 0;
var verbose = 0;

# --- resolve kernel location ---

fn resolve_kernel() {
    if (kernel_path != 0) { return kernel_path; }

    # Try sibling agnos repo (scripts/ is inside agnosticos/)
    var sibling = "../../agnos/build/agnos";
    var fd = sys_open(sibling, O_RDONLY, 0);
    if (fd >= 0) {
        sys_close(fd);
        kernel_path = str_from(sibling);
        return kernel_path;
    }

    # Try installed location
    var installed = "/usr/lib/agnos/kernel";
    fd = sys_open(installed, O_RDONLY, 0);
    if (fd >= 0) {
        sys_close(fd);
        kernel_path = str_from(installed);
        return kernel_path;
    }

    println("ERROR: AGNOS kernel not found");
    println("  Expected: ../agnos/build/agnos");
    println("  Or:       /usr/lib/agnos/kernel");
    println("  Use --kernel /path/to/agnos");
    sys_exit(1);
    return 0;
}

# --- file size via lseek ---

fn file_size(path) {
    var fd = sys_open(str_data(path), O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var sz = syscall(8, fd, 0, 2);  # lseek(fd, 0, SEEK_END)
    sys_close(fd);
    return sz;
}

# --- QEMU direct boot ---

fn qemu_direct(test_mode) {
    var kpath = resolve_kernel();

    println("");
    println("--- AGNOS Boot Pipeline ---");
    prints("  kernel: ");
    println(str_data(kpath));

    var sz = file_size(kpath);
    if (sz > 0) {
        prints("  size:   ");
        print_int(sz);
        println(" bytes");
    }

    var qargs = vec_new();
    vec_push(qargs, "/usr/bin/qemu-system-x86_64");
    vec_push(qargs, "-kernel");
    vec_push(qargs, str_data(kpath));
    vec_push(qargs, "-serial");
    vec_push(qargs, "stdio");
    vec_push(qargs, "-display");
    vec_push(qargs, "none");
    vec_push(qargs, "-no-reboot");

    if (test_mode == 1) {
        println("  mode:   test (validating serial output)");
        println("");

        var outbuf = alloc(65536);
        var n = exec_capture(qargs, outbuf, 65536);

        if (n <= 0) {
            println("FAIL: QEMU produced no output (kernel may have crashed)");
            sys_exit(1);
        }

        # Search for AGNOS banner in serial output
        var found = 0;
        var si = 0;
        while (si < n - 5) {
            if (memeq(outbuf + si, "AGNOS", 5) == 1) {
                found = 1;
            }
            si = si + 1;
        }

        if (found == 1) {
            println("PASS: AGNOS kernel booted (banner detected in serial output)");
            prints("  captured ");
            print_int(n);
            println(" bytes of serial output");
        } else {
            println("FAIL: AGNOS banner not found in serial output");
            prints("  captured ");
            print_int(n);
            println(" bytes");
            println("  first 256 bytes:");
            var plen = n;
            if (plen > 256) { plen = 256; }
            sys_write(1, outbuf, plen);
            prints("\n");
            sys_exit(1);
        }
    } else {
        println("  mode:   interactive (Ctrl-A X to quit)");
        println("");
        exec_vec(qargs);
    }
}

# --- CLI ---

fn parse_args() {
    args_init();
    var i = 1;
    while (i < argc()) {
        var arg = argv(i);
        if (streq(arg, "--help") == 1) {
            println("AGNOS Boot Pipeline");
            println("");
            println("Usage: boot [OPTIONS]");
            println("");
            println("Options:");
            println("  --test           Boot + validate AGNOS banner in serial output");
            println("  --kernel PATH    Path to AGNOS kernel binary");
            println("  -v, --verbose    Verbose output");
            println("  -h, --help       Show this help");
            println("");
            println("Default: direct boot from ../agnos/build/agnos (interactive)");
            sys_exit(0);
        }
        elif (streq(arg, "-h") == 1) {
            println("Usage: boot [--test] [--kernel PATH] [-v]");
            sys_exit(0);
        }
        elif (streq(arg, "--test") == 1) { mode = 1; }
        elif (streq(arg, "-v") == 1) { verbose = 1; }
        elif (streq(arg, "--verbose") == 1) { verbose = 1; }
        elif (streq(arg, "--kernel") == 1) {
            i = i + 1;
            if (i < argc()) { kernel_path = str_from(argv(i)); }
        }
        else {
            prints("Unknown option: ");
            println(arg);
            sys_exit(1);
        }
        i = i + 1;
    }
}

# --- main ---

fn main() {
    alloc_init();
    parse_args();

    if (mode == 1) {
        qemu_direct(1);
    } else {
        qemu_direct(0);
    }
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
