# boot.cyr — AGNOS sovereign boot pipeline
#
# Assembles and boots AGNOS from sibling repo components.
# No manual includes — cyrius build auto-resolves from cyrius.toml.
#
# Usage:
#   cyrius build src/boot.cyr build/boot
#   ./build/boot                  # direct boot (fastest)
#   ./build/boot --test           # boot + validate serial output
#   ./build/boot --status         # show component versions + sizes
#   ./build/boot --kernel PATH    # custom kernel path
#   ./build/boot -v               # verbose

# --- helpers ---

fn prints(s) { syscall(1, 1, s, strlen(s)); }

fn print_int(n) { print_num(n); }

# --- state ---

var kernel_path = 0;
var mode = 0;
var verbose = 0;

# mode values
# 0 = interactive boot
# 1 = test (validate serial output)
# 2 = status (show component info)

# --- file helpers ---

fn file_exists(path) {
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd >= 0) {
        sys_close(fd);
        return 1;
    }
    return 0;
}

fn file_size(path) {
    var fd = sys_open(str_data(path), O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var sz = syscall(8, fd, 0, 2);  # lseek(fd, 0, SEEK_END)
    sys_close(fd);
    return sz;
}

fn read_version(path) {
    var buf = alloc(64);
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { return str_from("?"); }
    var n = sys_read(fd, buf, 63);
    sys_close(fd);
    if (n <= 0) { return str_from("?"); }
    # Trim trailing newline
    if (n > 0) {
        if (load8(buf + n - 1) == 10) { n = n - 1; }
    }
    store8(buf + n, 0);
    return str_from(buf);
}

# --- resolve kernel location ---

fn resolve_kernel() {
    if (kernel_path != 0) { return kernel_path; }

    # Try sibling agnos repo (scripts/ is inside agnosticos/)
    var sibling = "../../agnos/build/agnos";
    if (file_exists(sibling) == 1) {
        kernel_path = str_from(sibling);
        return kernel_path;
    }

    # Try installed location
    var installed = "/usr/lib/agnos/kernel";
    if (file_exists(installed) == 1) {
        kernel_path = str_from(installed);
        return kernel_path;
    }

    println("ERROR: AGNOS kernel not found");
    println("  Expected: ../../agnos/build/agnos");
    println("  Or:       /usr/lib/agnos/kernel");
    println("  Use --kernel /path/to/agnos");
    sys_exit(1);
    return 0;
}

# --- component status ---

fn show_component(name, version_path, binary_path) {
    prints("  ");
    prints(name);
    # Pad name to 14 chars
    var nlen = strlen(name);
    var pad = 14 - nlen;
    while (pad > 0) {
        prints(" ");
        pad = pad - 1;
    }

    # Version
    if (file_exists(version_path) == 1) {
        var ver = read_version(version_path);
        prints("v");
        prints(str_data(ver));
    } else {
        prints("---");
    }

    # Binary size
    if (binary_path != 0) {
        if (file_exists(binary_path) == 1) {
            var bpath = str_from(binary_path);
            var sz = file_size(bpath);
            if (sz > 0) {
                prints("  (");
                print_int(sz);
                prints(" bytes)");
            }
        }
    }

    prints("\n");
}

fn show_status() {
    println("");
    println("=== AGNOS Component Status ===");
    println("");

    # Core chain
    println("--- Boot Chain ---");
    show_component("kernel",    "../../agnos/VERSION",     "../../agnos/build/agnos");
    show_component("cyrius",    "../../cyrius/VERSION",    "../../cyrius/build/cc3");
    show_component("kybernet",  "../../kybernet/VERSION",  0);
    show_component("argonaut",  "../../argonaut/VERSION",  0);
    show_component("ark",       "../../ark/VERSION",       0);
    show_component("nous",      "../../nous/VERSION",      0);
    println("");

    # Agent layer
    println("--- Agent Layer ---");
    show_component("daimon",    "../../daimon/VERSION",    0);
    show_component("hoosh",     "../../hoosh/VERSION",     0);
    show_component("bote",      "../../bote/VERSION",      0);
    show_component("t-ron",     "../../t-ron/VERSION",     0);
    show_component("agnoshi",   "../../agnoshi/VERSION",   0);
    println("");

    # Infrastructure
    println("--- Infrastructure ---");
    show_component("sigil",     "../../sigil/VERSION",     0);
    show_component("libro",     "../../libro/VERSION",     0);
    show_component("kavach",    "../../kavach/VERSION",    0);
    show_component("agnostik",  "../../agnostik/VERSION",  0);
    show_component("agnosys",   "../../agnosys/VERSION",   0);
    show_component("bsp",       "../../bsp/VERSION",       0);
    println("");

    # Knowledge & Consciousness
    println("--- Knowledge & Consciousness ---");
    show_component("hadara",    "../../hadara/VERSION",    0);
    show_component("avatara",   "../../avatara/VERSION",   0);
    show_component("bhava",     "../../bhava/VERSION",     0);
    show_component("itihas",    "../../itihas/VERSION",    0);
    show_component("hisab",     "../../hisab/VERSION",     0);
    show_component("ai-hwaccel","../../ai-hwaccel/VERSION",0);
    show_component("shravan",   "../../shravan/VERSION",   0);
    println("");

    # Applications
    println("--- Applications ---");
    show_component("cyrius-doom","../../cyrius-doom/VERSION",0);
    println("");

    # Boot pipeline
    println("--- Genesis ---");
    show_component("boot.cyr",  "../VERSION",              "build/boot");

    # Toolchain
    println("");
    prints("  toolchain:    ");
    var tbuf = alloc(256);
    var tn = exec_capture(
        vec_from("/usr/bin/env", "cc3", "--version"),
        tbuf, 256
    );
    if (tn > 0) {
        store8(tbuf + tn, 0);
        # Trim newline
        if (tn > 0) {
            if (load8(tbuf + tn - 1) == 10) { store8(tbuf + tn - 1, 0); }
        }
        println(tbuf);
    } else {
        println("not found");
    }
}

fn vec_from(a, b, c) {
    var v = vec_new();
    vec_push(v, a);
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    return v;
}

# --- QEMU direct boot ---

fn qemu_direct(test_mode) {
    var kpath = resolve_kernel();

    println("");
    println("=== AGNOS Boot Pipeline ===");
    prints("  kernel:   ");
    println(str_data(kpath));

    var sz = file_size(kpath);
    if (sz > 0) {
        prints("  size:     ");
        print_int(sz);
        println(" bytes");
    }

    # Show kernel version if available
    if (file_exists("../../agnos/VERSION") == 1) {
        var kver = read_version("../../agnos/VERSION");
        prints("  version:  ");
        println(str_data(kver));
    }

    var qargs = vec_new();
    vec_push(qargs, "/usr/bin/qemu-system-x86_64");
    vec_push(qargs, "-kernel");
    vec_push(qargs, str_data(kpath));
    vec_push(qargs, "-serial");
    vec_push(qargs, "stdio");
    vec_push(qargs, "-display");
    vec_push(qargs, "none");
    vec_push(qargs, "-no-reboot");
    # Memory for daimon + hoosh + services
    vec_push(qargs, "-m");
    vec_push(qargs, "512");

    if (test_mode == 1) {
        println("  mode:     test (validating serial output)");
        println("");

        var outbuf = alloc(65536);
        var n = exec_capture(qargs, outbuf, 65536);

        if (n <= 0) {
            println("FAIL: QEMU produced no output (kernel may have crashed)");
            sys_exit(1);
        }

        # Search for AGNOS banner in serial output
        var found = 0;
        var si = 0;
        while (si < n - 5) {
            if (memeq(outbuf + si, "AGNOS", 5) == 1) {
                found = 1;
            }
            si = si + 1;
        }

        if (found == 1) {
            println("PASS: AGNOS kernel booted (banner detected in serial output)");
            prints("  captured ");
            print_int(n);
            println(" bytes of serial output");
        } else {
            println("FAIL: AGNOS banner not found in serial output");
            prints("  captured ");
            print_int(n);
            println(" bytes");
            println("  first 256 bytes:");
            var plen = n;
            if (plen > 256) { plen = 256; }
            sys_write(1, outbuf, plen);
            prints("\n");
            sys_exit(1);
        }
    } else {
        println("  mode:     interactive (Ctrl-A X to quit)");
        println("  memory:   512MB");
        println("");
        exec_vec(qargs);
    }
}

# --- CLI ---

fn parse_args() {
    args_init();
    var i = 1;
    while (i < argc()) {
        var arg = argv(i);
        if (streq(arg, "--help") == 1) {
            println("AGNOS Boot Pipeline");
            println("");
            println("Usage: boot [OPTIONS]");
            println("");
            println("Options:");
            println("  --test           Boot + validate AGNOS banner in serial output");
            println("  --status         Show component versions and sizes");
            println("  --kernel PATH    Path to AGNOS kernel binary");
            println("  -v, --verbose    Verbose output");
            println("  -h, --help       Show this help");
            println("");
            println("Default: direct boot from ../../agnos/build/agnos (interactive)");
            sys_exit(0);
        }
        elif (streq(arg, "-h") == 1) {
            println("Usage: boot [--test] [--status] [--kernel PATH] [-v]");
            sys_exit(0);
        }
        elif (streq(arg, "--test") == 1) { mode = 1; }
        elif (streq(arg, "--status") == 1) { mode = 2; }
        elif (streq(arg, "-v") == 1) { verbose = 1; }
        elif (streq(arg, "--verbose") == 1) { verbose = 1; }
        elif (streq(arg, "--kernel") == 1) {
            i = i + 1;
            if (i < argc()) { kernel_path = str_from(argv(i)); }
        }
        else {
            prints("Unknown option: ");
            println(arg);
            sys_exit(1);
        }
        i = i + 1;
    }
}

# --- main ---

fn main() {
    alloc_init();
    parse_args();

    if (mode == 2) {
        show_status();
        return 0;
    }

    if (mode == 1) {
        qemu_direct(1);
    } else {
        qemu_direct(0);
    }
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
