# install.cyr — AGNOS first-hardware-boot installer
#
# Builds an initramfs.cpio.gz containing kybernet + agnoshi + minimal config.
# Prints a GRUB entry snippet for the user to add to their bootloader.
#
# Scope: Stage 1 — produce artifacts. The user does partition/format/copy/
# grub-install themselves (those need root + are per-machine).
#
# Usage:
#   cyrius build src/install.cyr build/install
#   ./build/install                     # build with defaults
#   ./build/install --output PATH       # custom output path
#   ./build/install --kernel PATH       # custom kernel binary
#   ./build/install --kybernet PATH     # custom kybernet binary
#   ./build/install --agnoshi PATH      # custom agnoshi binary
#   ./build/install --daimon PATH       # also include daimon (optional)
#   ./build/install --grub-only         # just print GRUB snippet, no build
#   ./build/install --status            # show component versions + sizes
#   ./build/install -v                  # verbose

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/fs.cyr"
include "lib/args.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"

# --- output helpers ---

fn prints(s) { syscall(1, 1, s, strlen(s)); }
fn print_int(n) { print_num(n); }
fn println(s) { prints(s); prints("\n"); }
fn newline() { prints("\n"); }

# --- state ---

var kernel_path = 0;
var kybernet_path = 0;
var agnoshi_path = 0;
var daimon_path = 0;
var output_path = 0;
var grub_only = 0;
var status_mode = 0;
var verbose = 0;

# --- file helpers ---

fn file_exists(path) {
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd >= 0) { sys_close(fd); return 1; }
    return 0;
}

fn file_size(path) {
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var sz = syscall(8, fd, 0, 2);  # lseek(fd, 0, SEEK_END)
    sys_close(fd);
    return sz;
}

# Read file contents into a heap buffer; returns (buf_ptr, size).
# Caller is responsible for the buffer (we leak — short-lived process).
fn read_file(path) {
    var sz = file_size(path);
    if (sz <= 0) { return 0; }
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(sz);
    var n = sys_read(fd, buf, sz);
    sys_close(fd);
    if (n != sz) { return 0; }
    return buf;
}

# Write buf to path with mode (0o755 typical for binaries, 0o644 for data).
fn write_file(path, buf, sz, mode) {
    # O_WRONLY|O_CREAT|O_TRUNC = 0x241
    var fd = sys_open(path, 0x241, mode);
    if (fd < 0) { return 0 - 1; }
    var n = sys_write(fd, buf, sz);
    sys_close(fd);
    if (n != sz) { return 0 - 1; }
    return 0;
}

# mkdir -p semantics; OK if exists, fails on other errors.
fn mkdir_p(path) {
    sys_mkdir(path, 0x1ED);  # 0o755
    return 0;
}

# Join two cstring paths (prefix + suffix) into a heap-allocated null-terminated cstring.
# Caller owns the result (we leak — short-lived process; small buffers).
fn path_join(prefix, suffix) {
    var plen = strlen(prefix);
    var slen = strlen(suffix);
    var buf = alloc(plen + slen + 1);
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, suffix, slen);
    store8(buf + plen + slen, 0);
    return buf;
}

# --- resolve defaults (sibling-repo conventions) ---

fn resolve_kernel() {
    if (kernel_path != 0) { return kernel_path; }
    # Two levels up: binaries run from scripts/build/.
    return "../../agnos/build/agnos";
}

fn resolve_kybernet() {
    if (kybernet_path != 0) { return kybernet_path; }
    return "../../kybernet/build/kybernet";
}

fn resolve_agnoshi() {
    if (agnoshi_path != 0) { return agnoshi_path; }
    return "../../agnoshi/build/agnsh";
}

fn resolve_daimon() {
    if (daimon_path != 0) { return daimon_path; }
    # Optional — return path; caller checks file_exists.
    return "../../daimon/build/daimon";
}

fn resolve_output() {
    if (output_path != 0) { return output_path; }
    # Output relative to invocation cwd (scripts/), parallel to boot binary.
    return "build/initramfs.cpio.gz";
}

# --- vec helper (mirrors boot.cyr pattern) ---

fn vec_from(a, b, c) {
    var v = vec_new();
    vec_push(v, a);
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    return v;
}

fn vec_from5(a, b, c, d, e) {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    if (e != 0) { vec_push(v, e); }
    return v;
}

# --- copy a file via host `cp` ---
# Cyrius-orchestration: shell out for proven file-copy semantics + mode preservation.

fn copy_file(src, dst) {
    if (file_exists(src) == 0) {
        prints("ERROR: missing source file: ");
        println(src);
        return 0 - 1;
    }
    if (verbose == 1) {
        prints("  cp ");
        prints(src);
        prints(" -> ");
        println(dst);
    }
    var r = exec_vec(vec_from5("/usr/bin/env", "cp", "-f", src, dst));
    return r;
}

# --- staging-dir layout ---

fn build_rootfs(rootfs) {
    prints("Building rootfs at ");
    println(rootfs);

    # --- 1. clean staging dir ---
    exec_vec(vec_from5("/usr/bin/env", "rm", "-rf", rootfs, 0));
    mkdir_p(rootfs);

    # --- 2. directory skeleton ---
    var dirs = vec_new();
    vec_push(dirs, "/sbin");
    vec_push(dirs, "/usr");
    vec_push(dirs, "/usr/bin");
    vec_push(dirs, "/usr/lib");
    vec_push(dirs, "/usr/lib/agnos");
    vec_push(dirs, "/etc");
    vec_push(dirs, "/etc/kybernet");
    vec_push(dirs, "/proc");
    vec_push(dirs, "/sys");
    vec_push(dirs, "/sys/fs");
    vec_push(dirs, "/sys/fs/cgroup");
    vec_push(dirs, "/dev");
    vec_push(dirs, "/dev/pts");
    vec_push(dirs, "/dev/shm");
    vec_push(dirs, "/run");
    vec_push(dirs, "/tmp");
    vec_push(dirs, "/var");
    vec_push(dirs, "/var/log");

    var i = 0;
    var n = vec_len(dirs);
    var pathbuf = alloc(512);
    while (i < n) {
        var sub = vec_get(dirs, i);
        var p = pathbuf;
        var rlen = strlen(rootfs);
        memcpy(p, rootfs, rlen);
        memcpy(p + rlen, sub, strlen(sub));
        store8(p + rlen + strlen(sub), 0);
        mkdir_p(p);
        i = i + 1;
    }

    # --- 3. stage binaries ---
    # kybernet → /init AND /sbin/init
    # The Linux kernel initramfs handler execs /init if it exists; we copy
    # the kybernet binary there directly. /sbin/init is Linux-convention
    # fallback. Both files for robustness.
    var kybernet_src = resolve_kybernet();

    var init_dst = path_join(rootfs, "/init");
    if (copy_file(kybernet_src, init_dst) != 0) { return 0 - 1; }
    exec_vec(vec_from5("/usr/bin/env", "chmod", "+x", init_dst, 0));

    var sbin_init_dst = path_join(rootfs, "/sbin/init");
    if (copy_file(kybernet_src, sbin_init_dst) != 0) { return 0 - 1; }
    exec_vec(vec_from5("/usr/bin/env", "chmod", "+x", sbin_init_dst, 0));

    # agnoshi → /usr/lib/agnos/agnoshi (argonaut services.cyr path)
    #        AND /usr/bin/agnoshi (kybernet emergency-shell-default path)
    var agnoshi_src = resolve_agnoshi();
    var agnoshi_lib_dst = path_join(rootfs, "/usr/lib/agnos/agnoshi");
    if (copy_file(agnoshi_src, agnoshi_lib_dst) != 0) { return 0 - 1; }
    exec_vec(vec_from5("/usr/bin/env", "chmod", "+x", agnoshi_lib_dst, 0));

    var agnoshi_bin_dst = path_join(rootfs, "/usr/bin/agnoshi");
    if (copy_file(agnoshi_src, agnoshi_bin_dst) != 0) { return 0 - 1; }
    exec_vec(vec_from5("/usr/bin/env", "chmod", "+x", agnoshi_bin_dst, 0));

    # daimon → /usr/lib/agnos/agent_runtime (argonaut services.cyr path)
    # Optional — included if daimon binary is available; otherwise
    # daimon service in BOOT_MINIMAL will fail to start (non-fatal —
    # agnoshi still launches; kybernet stays up).
    var daimon_src = resolve_daimon();
    if (file_exists(daimon_src) == 1) {
        var daimon_dst = path_join(rootfs, "/usr/lib/agnos/agent_runtime");
        copy_file(daimon_src, daimon_dst);
        exec_vec(vec_from5("/usr/bin/env", "chmod", "+x", daimon_dst, 0));
    } else {
        if (verbose == 1) {
            prints("  (daimon binary not at ");
            prints(daimon_src);
            println(" — skipping; BOOT_MINIMAL agnoshi still launches)");
        }
    }

    # --- 4. config files ---
    # /etc/kybernet/config.json: boot_mode = minimal
    # Triggers default_services(BOOT_MINIMAL) which registers daimon + agnoshi
    # per argonaut 1.7.0.
    var cfg_json = "{\"boot_mode\": \"minimal\", \"log_to_console\": \"true\"}\n";
    var cfg_path = path_join(rootfs, "/etc/kybernet/config.json");
    if (write_file(cfg_path, cfg_json, strlen(cfg_json), 0x1A4) != 0) {  # 0o644
        println("ERROR: failed to write kybernet config.json");
        return 0 - 1;
    }

    # /etc/hostname (cosmetic but helps when you log in and see something)
    var hostname = "agnos\n";
    var hostname_path = path_join(rootfs, "/etc/hostname");
    write_file(hostname_path, hostname, strlen(hostname), 0x1A4);

    # /etc/os-release (identity for any tool that asks)
    var os_release = "NAME=AGNOS\nID=agnos\nPRETTY_NAME=\"AGNOS (Closed Beta MVP)\"\n";
    var osrel_path = path_join(rootfs, "/etc/os-release");
    write_file(osrel_path, os_release, strlen(os_release), 0x1A4);

    println("  rootfs layout staged");
    return 0;
}

# --- host-tool preflight ---

# Returns 1 if a binary by this name exists at one of the standard locations.
# Direct file_exists check — avoids needing PATH in the child env.
fn have_tool(tool) {
    var buf = alloc(512);
    var prefix = "/usr/bin/";
    memcpy(buf, prefix, 9);
    var tlen = strlen(tool);
    memcpy(buf + 9, tool, tlen);
    store8(buf + 9 + tlen, 0);
    if (file_exists(buf) == 1) { return 1; }

    # /bin/<tool> fallback
    prefix = "/bin/";
    memcpy(buf, prefix, 5);
    memcpy(buf + 5, tool, tlen);
    store8(buf + 5 + tlen, 0);
    if (file_exists(buf) == 1) { return 1; }

    # /usr/local/bin/<tool>
    prefix = "/usr/local/bin/";
    memcpy(buf, prefix, 15);
    memcpy(buf + 15, tool, tlen);
    store8(buf + 15 + tlen, 0);
    if (file_exists(buf) == 1) { return 1; }

    return 0;
}

fn preflight_host_tools() {
    var ok = 1;
    if (have_tool("cpio") == 0) {
        println("ERROR: 'cpio' not found on PATH — required to build initramfs.");
        println("  Install on Arch:        sudo pacman -S cpio");
        println("  Install on Debian/Ub.:  sudo apt-get install cpio");
        println("  Install on Fedora/RHEL: sudo dnf install cpio");
        ok = 0;
    }
    if (have_tool("gzip") == 0) {
        println("ERROR: 'gzip' not found on PATH — required to compress initramfs.");
        ok = 0;
    }
    if (have_tool("find") == 0) {
        println("ERROR: 'find' not found on PATH — required to list rootfs files.");
        ok = 0;
    }
    return ok;
}

# --- assemble cpio.gz ---

fn assemble_initramfs(rootfs, output) {
    prints("Assembling initramfs -> ");
    println(output);

    # Ensure output parent dir exists
    mkdir_p("build");

    # cd to rootfs; find . | cpio -o -H newc | gzip > output
    # Run via sh -c to handle the pipe + cd.
    # Build the command string manually via memcpy (no str_append in stdlib 5.10.44).
    var cmd = alloc(1024);
    var pre1 = "cd ";
    var mid  = " && find . | cpio -o -H newc 2>/dev/null | gzip -9 > ../../";
    var off = 0;
    var l = strlen(pre1);
    memcpy(cmd + off, pre1, l); off = off + l;
    l = strlen(rootfs);
    memcpy(cmd + off, rootfs, l); off = off + l;
    l = strlen(mid);
    memcpy(cmd + off, mid, l); off = off + l;
    l = strlen(output);
    memcpy(cmd + off, output, l); off = off + l;
    store8(cmd + off, 0);

    if (verbose == 1) {
        prints("  $ ");
        println(cmd);
    }

    var args = vec_new();
    vec_push(args, "/usr/bin/env");
    vec_push(args, "sh");
    vec_push(args, "-c");
    vec_push(args, cmd);
    var r = exec_vec(args);

    if (file_exists(output) == 0) {
        println("ERROR: initramfs assembly failed (output file not produced)");
        return 0 - 1;
    }

    var sz = file_size(output);
    if (sz < 1024) {
        prints("ERROR: initramfs is suspiciously small (");
        print_int(sz);
        println(" bytes) — cpio likely failed.");
        println("  Run 'which cpio' to verify cpio is installed.");
        return 0 - 1;
    }
    prints("  initramfs.cpio.gz: ");
    print_int(sz);
    println(" bytes");
    return 0;
}

# --- GRUB snippet printer ---

fn print_grub_snippet() {
    var kernel = resolve_kernel();
    var output = resolve_output();

    println("");
    println("=== GRUB ENTRY (append to /etc/grub.d/40_custom, then grub-mkconfig) ===");
    println("");
    println("menuentry 'AGNOS — Closed Beta MVP (boot to shell)' {");
    println("    insmod multiboot");
    println("    insmod gzio");
    println("    # NOTE: Adjust paths to wherever you copy the kernel + initramfs.");
    println("    # Example (host /boot/agnos/ layout):");
    println("    #   multiboot /boot/agnos/agnos");
    println("    #   module    /boot/agnos/initramfs.cpio.gz");
    println("    multiboot /boot/agnos/agnos");
    println("    module    /boot/agnos/initramfs.cpio.gz");
    println("    boot");
    println("}");
    println("");
    println("=== MANUAL STEPS (user-runs, root required) ===");
    println("");
    println("  # 1. Copy kernel + initramfs to /boot (or your AGNOS boot partition):");
    prints("  sudo mkdir -p /boot/agnos && sudo cp ");
    prints(kernel);
    println(" /boot/agnos/agnos");
    prints("  sudo cp ");
    prints(output);
    println(" /boot/agnos/initramfs.cpio.gz");
    println("");
    println("  # 2. Add the GRUB entry above to /etc/grub.d/40_custom (make it executable):");
    println("  sudo chmod +x /etc/grub.d/40_custom");
    println("");
    println("  # 3. Regenerate GRUB config:");
    println("  sudo grub-mkconfig -o /boot/grub/grub.cfg");
    println("  # (or grub2-mkconfig on Fedora/RHEL-family)");
    println("");
    println("  # 4. Reboot and select 'AGNOS — Closed Beta MVP' at GRUB.");
    println("  #    The kernel boots, kybernet starts as PID 1, agnoshi prints a prompt.");
    println("");
    println("=== ROLLBACK (if AGNOS doesn't boot cleanly) ===");
    println("");
    println("  # Hold Shift at boot to force GRUB menu, select your normal OS.");
    println("  # Remove /etc/grub.d/40_custom entry, re-run grub-mkconfig.");
    println("");
    return 0;
}

# --- status display ---

fn show_status() {
    var kernel = resolve_kernel();
    var kybernet = resolve_kybernet();
    var agnoshi = resolve_agnoshi();
    var daimon = resolve_daimon();
    var output = resolve_output();

    println("=== AGNOS Install Pipeline — Component Status ===");
    println("");

    prints("  kernel:      ");
    prints(kernel);
    if (file_exists(kernel) == 1) {
        prints("  (");
        print_int(file_size(kernel));
        println(" B)");
    } else {
        println("  MISSING");
    }

    prints("  kybernet:    ");
    prints(kybernet);
    if (file_exists(kybernet) == 1) {
        prints("  (");
        print_int(file_size(kybernet));
        println(" B)");
    } else {
        println("  MISSING");
    }

    prints("  agnoshi:     ");
    prints(agnoshi);
    if (file_exists(agnoshi) == 1) {
        prints("  (");
        print_int(file_size(agnoshi));
        println(" B)");
    } else {
        println("  MISSING");
    }

    prints("  daimon:      ");
    prints(daimon);
    if (file_exists(daimon) == 1) {
        prints("  (");
        print_int(file_size(daimon));
        println(" B)");
    } else {
        println("  (optional, not present)");
    }

    println("");
    prints("  output:      ");
    println(output);

    println("");
    return 0;
}

# --- args parsing ---

fn parse_args() {
    args_init();
    var i = 1;
    while (i < argc()) {
        var arg = argv(i);
        if (streq(arg, "--kernel") == 1) {
            i = i + 1;
            kernel_path = argv(i);
        } elif (streq(arg, "--kybernet") == 1) {
            i = i + 1;
            kybernet_path = argv(i);
        } elif (streq(arg, "--agnoshi") == 1) {
            i = i + 1;
            agnoshi_path = argv(i);
        } elif (streq(arg, "--daimon") == 1) {
            i = i + 1;
            daimon_path = argv(i);
        } elif (streq(arg, "--output") == 1) {
            i = i + 1;
            output_path = argv(i);
        } elif (streq(arg, "--grub-only") == 1) {
            grub_only = 1;
        } elif (streq(arg, "--status") == 1) {
            status_mode = 1;
        } elif (streq(arg, "-v") == 1) {
            verbose = 1;
        } elif (streq(arg, "--verbose") == 1) {
            verbose = 1;
        } elif (streq(arg, "--help") == 1) {
            println("install.cyr — AGNOS first-hardware-boot installer");
            println("");
            println("Usage:");
            println("  ./build/install                 build initramfs + print GRUB snippet");
            println("  ./build/install --status        show component versions/sizes");
            println("  ./build/install --grub-only     print GRUB snippet only (no build)");
            println("  ./build/install --output PATH   custom output (default: build/initramfs.cpio.gz)");
            println("  ./build/install --kernel PATH   custom kernel binary path");
            println("  ./build/install --kybernet PATH custom kybernet binary path");
            println("  ./build/install --agnoshi PATH  custom agnoshi binary path");
            println("  ./build/install --daimon PATH   custom daimon binary path (optional)");
            println("  ./build/install -v              verbose output");
            sys_exit(0);
        }
        i = i + 1;
    }
    return 0;
}

# --- main ---

fn main() {
    parse_args();

    if (status_mode == 1) {
        show_status();
        return 0;
    }

    if (grub_only == 1) {
        print_grub_snippet();
        return 0;
    }

    # Host-tool preflight (cpio, gzip, find)
    if (preflight_host_tools() == 0) {
        println("");
        println("Required host tools missing. Install them and re-run.");
        return 1;
    }

    # Component preflight
    var kernel = resolve_kernel();
    var kybernet = resolve_kybernet();
    var agnoshi = resolve_agnoshi();

    var missing = 0;
    if (file_exists(kernel) == 0) {
        prints("ERROR: kernel not found: ");
        println(kernel);
        missing = 1;
    }
    if (file_exists(kybernet) == 0) {
        prints("ERROR: kybernet not found: ");
        println(kybernet);
        missing = 1;
    }
    if (file_exists(agnoshi) == 0) {
        prints("ERROR: agnoshi not found: ");
        println(agnoshi);
        missing = 1;
    }
    if (missing == 1) {
        println("");
        println("Run with --status to see all component paths.");
        return 1;
    }

    # Build rootfs staging dir
    var rootfs = "build/rootfs";
    if (build_rootfs(rootfs) != 0) {
        println("ERROR: rootfs build failed");
        return 1;
    }

    # Assemble cpio.gz
    var output = resolve_output();
    if (assemble_initramfs(rootfs, output) != 0) {
        println("ERROR: initramfs assembly failed");
        return 1;
    }

    # Print GRUB snippet + instructions
    print_grub_snippet();

    println("=== DONE ===");
    println("");
    prints("  Initramfs: ");
    println(output);
    prints("  Kernel:    ");
    println(kernel);
    println("");
    println("Next: copy both to /boot/agnos/, add GRUB entry, reboot, select AGNOS.");
    println("(See instructions above.)");
    println("");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
