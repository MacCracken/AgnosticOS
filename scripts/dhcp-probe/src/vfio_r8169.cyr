# vfio_r8169 — drive the real RTL8168 from Linux userland via VFIO, running
# AGNOS's own r8169 register sequence against live hardware.
#
# WHY: AGNOS 1.32.6 receives broadcast + multicast on iron but NEVER the
# gateway's unicast ARP reply. arp_reply_len.cyr proved on Linux that the
# reply is a normal 60-byte unicast frame Linux's r8169 receives every time
# on this exact chip -> wire + chip + gateway all good; the bug is 100% in
# AGNOS's r8169 *config*. Specifically: the RX accept nibble (APM unicast +
# AAP promiscuous) never engages (even AAP delivers zero unicast), while AB/AM
# only leak through the MAR=all-1s hash.
#
# This binary reproduces AGNOS's EXACT init + ring + poll against the real
# chip, with FULL register-readback + hardware-tally-counter visibility that
# iron (FB/CMOS only) can never give — no burn, no reboot, iterate in seconds.
#
# BITE 1 (this stage): VFIO scaffold + MMIO map. Proves the plumbing by
# reading IDR0-5 (MAC) and the TxConfig chip-rev byte straight off the BAR.
# Expect MAC b0:41:6f:0c:e4:25, chip-rev 0x15 (rev 21 = RTL8168H/mac_ver 46).
#
# Prereq: sudo ./vfio-bind.sh   (binds enp1s0 -> vfio-pci, group 10)
# Run:    sudo ./build/vfio-r8169
# Restore: sudo ./vfio-unbind.sh

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"

# === Print helpers ===
fn prints(s) { syscall(1, 1, s, strlen(s)); }
fn putc(c) { var b[1]; store8(&b, c); syscall(1, 1, &b, 1); }
fn newline() { syscall(1, 1, "\n", 1); }
fn print_mac(mac) {
    fmt_byte(load8(mac));
    var i: i64 = 1;
    while (i < 6) { putc(58); fmt_byte(load8(mac + i)); i = i + 1; }
}

# === syscall numbers (x86-64) ===
var SYS_read   = 0;
var SYS_write  = 1;
var SYS_open   = 2;
var SYS_close  = 3;
var SYS_mmap   = 9;
var SYS_ioctl  = 16;
var SYS_exit   = 60;

var O_RDWR     = 2;
var PROT_RW    = 3;     # PROT_READ|PROT_WRITE
var MAP_SHARED = 1;

# === VFIO ioctl request numbers — _IO(';',N) = (0x3B << 8) | N ===
var VFIO_GET_API_VERSION        = 0x3B64;   # _IO(';',100)
var VFIO_CHECK_EXTENSION        = 0x3B65;   # _IO(';',101)
var VFIO_SET_IOMMU              = 0x3B66;   # _IO(';',102)
var VFIO_GROUP_GET_STATUS       = 0x3B67;   # _IO(';',103)
var VFIO_GROUP_SET_CONTAINER    = 0x3B68;   # _IO(';',104)
var VFIO_GROUP_GET_DEVICE_FD    = 0x3B6A;   # _IO(';',106)
var VFIO_DEVICE_GET_REGION_INFO = 0x3B6C;   # _IO(';',108)
var VFIO_IOMMU_MAP_DMA          = 0x3B71;   # _IO(';',113)

var VFIO_API_VERSION            = 0;
var VFIO_TYPE1_IOMMU            = 1;
var VFIO_GROUP_FLAGS_VIABLE     = 1;
var VFIO_PCI_BAR2_REGION_INDEX  = 2;

# === r8169 register offsets (from agnos/kernel/core/r8169.cyr) ===
var REG_IDR0     = 0x00;
var REG_TXCONFIG = 0x40;

fn die(msg, code): i64 {
    prints("FATAL: "); prints(msg); newline();
    syscall(SYS_exit, code);
    return code;
}

fn main(): i64 {
    prints("vfio_r8169 — bite 1: VFIO scaffold + MMIO proof\n");
    prints("================================================\n");

    # --- 1. Open the VFIO container ---------------------------------
    var container = syscall(SYS_open, "/dev/vfio/vfio", O_RDWR, 0);
    if (container < 0) {
        prints("open /dev/vfio/vfio failed errno="); fmt_int(0 - container); newline();
        return die("is vfio loaded? run: sudo ./vfio-bind.sh", 2);
    }
    prints("  container fd="); fmt_int(container); newline();

    var api = syscall(SYS_ioctl, container, VFIO_GET_API_VERSION, 0);
    prints("  VFIO_GET_API_VERSION="); fmt_int(api);
    if (api != VFIO_API_VERSION) { prints("  (UNEXPECTED, want 0)"); }
    newline();

    # --- 2. Open the IOMMU group (enp1s0 = group 10) ----------------
    var group = syscall(SYS_open, "/dev/vfio/10", O_RDWR, 0);
    if (group < 0) {
        prints("open /dev/vfio/10 failed errno="); fmt_int(0 - group); newline();
        return die("group not bound to vfio-pci? run: sudo ./vfio-bind.sh", 3);
    }
    prints("  group fd="); fmt_int(group); newline();

    # vfio_group_status { u32 argsz; u32 flags; }  (8 bytes)
    var gstatus[8];
    store32(&gstatus + 0, 8);                 # argsz
    store32(&gstatus + 4, 0);                 # flags (filled by kernel)
    var r = syscall(SYS_ioctl, group, VFIO_GROUP_GET_STATUS, &gstatus);
    if (r < 0) { return die("VFIO_GROUP_GET_STATUS failed", 4); }
    var gflags = load32(&gstatus + 4);
    prints("  group flags=0x"); fmt_hex(gflags);
    if ((gflags & VFIO_GROUP_FLAGS_VIABLE) == 0) {
        newline();
        return die("group NOT VIABLE — every device in the group must be vfio-bound", 5);
    }
    prints("  (VIABLE)\n");

    # --- 3. Attach group to container, set type1 IOMMU --------------
    var cfd[4];
    store32(&cfd, container);                  # arg = pointer to container fd (i32)
    r = syscall(SYS_ioctl, group, VFIO_GROUP_SET_CONTAINER, &cfd);
    if (r < 0) { return die("VFIO_GROUP_SET_CONTAINER failed", 6); }

    var ext = syscall(SYS_ioctl, container, VFIO_CHECK_EXTENSION, VFIO_TYPE1_IOMMU);
    prints("  CHECK_EXTENSION(TYPE1)="); fmt_int(ext); newline();
    if (ext < 1) { return die("type1 IOMMU not supported", 7); }

    r = syscall(SYS_ioctl, container, VFIO_SET_IOMMU, VFIO_TYPE1_IOMMU);
    if (r < 0) { return die("VFIO_SET_IOMMU(type1) failed", 8); }
    prints("  IOMMU type1 set\n");

    # --- 4. Get the device fd ---------------------------------------
    var device = syscall(SYS_ioctl, group, VFIO_GROUP_GET_DEVICE_FD, "0000:01:00.0");
    if (device < 0) {
        prints("VFIO_GROUP_GET_DEVICE_FD failed errno="); fmt_int(0 - device); newline();
        return die("device 0000:01:00.0 not in this group?", 9);
    }
    prints("  device fd="); fmt_int(device); newline();

    # --- 5. Region info for BAR2 (MMIO) -----------------------------
    # vfio_region_info { u32 argsz; u32 flags; u32 index; u32 cap_offset;
    #                    u64 size; u64 offset; }  (32 bytes)
    var rinfo[32];
    var i: i64 = 0;
    while (i < 32) { store8(&rinfo + i, 0); i = i + 1; }
    store32(&rinfo + 0, 32);                            # argsz
    store32(&rinfo + 8, VFIO_PCI_BAR2_REGION_INDEX);    # index = 2
    r = syscall(SYS_ioctl, device, VFIO_DEVICE_GET_REGION_INFO, &rinfo);
    if (r < 0) { return die("VFIO_DEVICE_GET_REGION_INFO(BAR2) failed", 10); }
    var bar_flags  = load32(&rinfo + 4);
    var bar_size   = load64(&rinfo + 16);
    var bar_offset = load64(&rinfo + 24);
    prints("  BAR2 flags=0x"); fmt_hex(bar_flags);
    prints(" size=0x"); fmt_hex(bar_size);
    prints(" offset=0x"); fmt_hex(bar_offset); newline();
    if (bar_size == 0) { return die("BAR2 size 0 — wrong region index?", 11); }

    # --- 6. mmap the MMIO region ------------------------------------
    var mmio = syscall(SYS_mmap, 0, bar_size, PROT_RW, MAP_SHARED, device, bar_offset);
    if (mmio < 0) {
        prints("mmap BAR2 failed errno="); fmt_int(0 - mmio); newline();
        return die("mmap", 12);
    }
    prints("  mmio mapped at 0x"); fmt_hex(mmio); newline();

    # --- 7. PROOF: read MAC (IDR0-5) + chip-rev straight off the BAR -
    var mac[8];
    i = 0;
    while (i < 6) { store8(&mac + i, load8(mmio + REG_IDR0 + i)); i = i + 1; }
    prints("\n  >>> IDR0-5 MAC = "); print_mac(&mac);
    prints("   (expect b0:41:6f:0c:e4:25)\n");

    var txcfg = load32(mmio + REG_TXCONFIG);
    var chiprev = (txcfg >> 24) & 0xFF;
    prints("  >>> TxConfig=0x"); fmt_hex(txcfg);
    prints("  chip-rev byte=0x"); fmt_hex(chiprev);
    prints("   (expect 0x15 = RTL8168H / mac_version 46)\n");

    prints("\nBITE 1 OK — VFIO scaffold + MMIO live. Next: DMA map + AGNOS init.\n");
    syscall(SYS_close, device);
    syscall(SYS_close, group);
    syscall(SYS_close, container);
    return 0;
}

var rc = main();
syscall(60, rc);
